---
import { SITE } from "../lib/site";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">{SITE.name}</p>
        <p class="footer-tagline">{SITE.book.tagline}</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <ul role="list">
          {SITE.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          {SITE.navRight.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sys-color-divider, #e5e7eb);
    background: var(--sys-surface-page, #f9f8f4);
    padding: 3rem 1.5rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sys-color-divider, #e5e7eb);
  }

  .footer-name {
    font-family: var(--sys-font-family-display, 'Jost', sans-serif);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0;
    color: var(--sys-color-on-surface, #000);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin: 0.25rem 0 0;
  }

  .footer-nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    font-size: 0.875rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--sys-color-on-surface, #000);
  }

  .footer-bottom {
    padding-top: 1.5rem;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }

    .footer-nav ul {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
