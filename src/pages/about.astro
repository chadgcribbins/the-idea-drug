---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const page = await getEntry("pages", "about");
const { Content } = await page.render();
const d = page.data as Record<string, any>;
---

<Layout title={d.title} description={d.description}>
  <section class="section section--lg">
    <div class="container container--narrow">
      <h1>About</h1>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Bio (markdown body) -->
  <section class="section">
    <div class="container container--narrow">
      <Content />
    </div>
  </section>

  <!-- Career arc (from frontmatter) -->
  <section class="section">
    <div class="container container--narrow">
      <h2>The journey</h2>
      <div class="timeline">
        {d.timeline?.map((item: { heading: string; period?: string; description?: string }) => (
          <div class="timeline-item">
            <h3>{item.heading}</h3>
            {item.period && <p class="text-muted">{item.period}</p>}
            {item.description && <p>{item.description}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section">
    <div class="container container--narrow">
      <p class="pull-quote">{d.philosophyQuote}</p>
    </div>
  </section>
</Layout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .timeline-item {
    padding-left: 1.5rem;
    border-left: 3px solid var(--sys-color-primary, #d42020);
  }

  .timeline-item h3 {
    margin-bottom: 0.25rem;
  }
</style>
