---
import Layout from "../layouts/Layout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import { SITE } from "../lib/site";
import { getEntry } from "astro:content";

const page = await getEntry("pages", "the-idea-drug");
const { Content } = await page.render();
const d = page.data as Record<string, any>;
---

<Layout title={d.title} description={d.description}>
  <section class="section section--lg">
    <div class="container">
      <div class="book-hero">
        <div class="book-cover">
          <img
            src="/images/cover.png"
            alt="The Idea Drug book cover"
            width="400"
            height="600"
            loading="eager"
          />
        </div>
        <div class="book-details">
          <h1>{SITE.book.title}</h1>
          <p class="book-subtitle">{SITE.book.subtitle}</p>
          <p class="book-publisher">Published by {SITE.book.publisher}</p>
          <div class="book-actions">
            <a href="#buy" class="btn btn--primary">Buy now</a>
            <a href="#free-chapter" class="btn btn--secondary">Free first chapter</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Synopsis -->
  <section class="section">
    <div class="container container--narrow">
      <h2>What's inside</h2>
      <p>{d.synopsis}</p>

      <div class="book-parts">
        {d.bookParts?.map((part: { heading: string; title: string; description: string }) => (
          <div class="book-part">
            <h3>{part.heading}</h3>
            <p class="book-part-title">{part.title}</p>
            <p>{part.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KLF inspiration -->
  <section class="section">
    <div class="container container--narrow">
      <p class="pull-quote">{d.klfQuote}</p>
    </div>
  </section>

  <!-- Trilogy (markdown body) -->
  <section class="section">
    <div class="container container--narrow">
      <Content />
    </div>
  </section>

  <!-- The talk -->
  <section class="section" id="talk">
    <div class="container container--narrow">
      <h2>The talk</h2>
      <p class="video-description">{d.videoDescription}</p>
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${d.videoId}`}
          title={d.videoTitle}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Buy links -->
  <section class="section" id="buy">
    <div class="container container--narrow">
      <h2>Get your copy</h2>
      <div class="buy-links">
        {d.buyLinks?.map((link: { label: string; href: string }, i: number) => (
          <a href={link.href} class:list={["btn", i === 0 ? "btn--primary" : "btn--secondary"]}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Email capture -->
  <section class="section" id="free-chapter">
    <div class="container container--narrow">
      <EmailCapture />
    </div>
  </section>
</Layout>

<style>
  .book-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: start;
  }

  .book-cover img {
    max-height: 500px;
    width: auto;
    box-shadow: var(--sys-surface-shadows-image, 0 16px 32px rgba(0, 0, 0, 0.12));
  }

  .book-subtitle {
    font-size: 1.2rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin-bottom: 0.5rem;
  }

  .book-publisher {
    font-size: 0.9rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin-bottom: 2rem;
  }

  .book-actions {
    display: flex;
    gap: 1rem;
  }

  .book-parts {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .book-part {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--sys-color-divider, #e5e7eb);
  }

  .book-part:last-child {
    border-bottom: none;
  }

  .book-part h3 {
    color: var(--sys-color-primary, #d42020);
    margin-bottom: 0.25rem;
  }

  .book-part-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .buy-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .video-description {
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--sys-surface-card, #f3f4f6);
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .book-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .book-cover {
      display: flex;
      justify-content: center;
    }

    .book-cover img {
      max-height: 350px;
    }

    .book-actions {
      justify-content: center;
    }
  }
</style>
