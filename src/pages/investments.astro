---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Investments"
  description="Portfolio companies and investments across energy, health, finance, food, and climate technology."
>
  <section class="section section--lg">
    <div class="container container--narrow">
      <h1>Investments</h1>
      <p class="lead">
        Active ventures and portfolio investments across sectors where
        hypothesis-led thinking creates unfair advantages.
      </p>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Active ventures -->
  <section class="section">
    <div class="container">
      <h2>Active ventures</h2>
      <div class="grid grid--3 mt-3">
        <div class="card">
          <h3>Juicy</h3>
          <p class="text-muted">Free domestic batteries</p>
        </div>
        <div class="card">
          <h3>Tx</h3>
          <p class="text-muted">Tokenised hashrate</p>
        </div>
        <div class="card">
          <h3>Slingshot</h3>
          <p class="text-muted">Algorithmic trading</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="section">
    <div class="container">
      <h2>Portfolio</h2>
      <div class="grid grid--3 mt-3">
        <div class="card">
          <h3>Civo</h3>
          <p class="text-muted">Cloud platform</p>
        </div>
        <div class="card">
          <h3>Nature Made</h3>
          <p class="text-muted">UPF-free food awards</p>
        </div>
        <div class="card">
          <h3>Labcycle</h3>
          <p class="text-muted">Medical plastics recycling</p>
        </div>
        <div class="card">
          <h3>Fanplanz</h3>
          <p class="text-muted">Object recognition</p>
        </div>
        <div class="card">
          <h3>Caldera</h3>
          <p class="text-muted">Heat batteries</p>
        </div>
        <div class="card">
          <h3>Optect</h3>
          <p class="text-muted">AI flame detection</p>
        </div>
        <div class="card">
          <h3>NewChange</h3>
          <p class="text-muted">FX data aggregation</p>
        </div>
        <div class="card">
          <h3>Ctrl Alt</h3>
          <p class="text-muted">FCA-registered fractional ownership</p>
        </div>
        <div class="card">
          <h3>RasTech</h3>
          <p class="text-muted">Containerised aquaculture</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lead {
    font-size: 1.2rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    line-height: 1.6;
  }
</style>
