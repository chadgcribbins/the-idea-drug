---
import Layout from "../layouts/Layout.astro";
import { getEntry, getCollection } from "astro:content";

const page = await getEntry("pages", "investments");
const d = page.data as Record<string, any>;

const allVentures = await getCollection("ventures");

const active = allVentures
  .filter((v) => v.data.status === "active")
  .sort((a, b) => a.data.order - b.data.order);

const portfolio = allVentures
  .filter((v) => v.data.status === "invested")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={d.title} description={d.description}>
  <section class="section section--lg">
    <div class="container container--narrow">
      <h1>Investments</h1>
      <p class="lead">{d.lead}</p>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Active ventures -->
  <section class="section">
    <div class="container">
      <h2>Active ventures</h2>
      <div class="grid grid--3 mt-3">
        {active.map((v) => (
          <div class="card">
            <h3>{v.data.name}</h3>
            <p class="text-muted">{v.data.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="section">
    <div class="container">
      <h2>Portfolio</h2>
      <div class="grid grid--3 mt-3">
        {portfolio.map((v) => (
          <div class="card">
            <h3>{v.data.name}</h3>
            <p class="text-muted">{v.data.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .lead {
    font-size: 1.2rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    line-height: 1.6;
  }
</style>
