---
import Layout from "../layouts/Layout.astro";
import { getEntry, getCollection } from "astro:content";

const page = await getEntry("pages", "system-two");
const { Content } = await page.render();
const d = page.data as Record<string, any>;

const exits = (await getCollection("ventures"))
  .filter((v) => v.data.status === "exited")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={d.title} description={d.description}>
  <section class="section section--lg">
    <div class="container container--narrow">
      <h1>System Two</h1>
      <p class="lead">{d.lead}</p>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Philosophy + framework (markdown body) -->
  <section class="section">
    <div class="container container--narrow">
      <Content />
      <p class="pull-quote mt-4">{d.frameworkQuote}</p>
    </div>
  </section>

  <!-- Exits (from ventures collection) -->
  <section class="section">
    <div class="container">
      <h2>Track record</h2>
      <div class="grid grid--3 mt-3">
        {exits.map((v) => (
          <div class="card">
            <h3>{v.data.name}</h3>
            <p class="text-muted">{v.data.sector} &middot; Acquired by {v.data.acquiredBy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rinsing -->
  <section class="section">
    <div class="container container--narrow">
      <h2>Book a Rinsing workshop</h2>
      <p>{d.rinsingDescription}</p>
      <a href="/contact" class="btn btn--primary mt-3">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .lead {
    font-size: 1.2rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    line-height: 1.6;
  }
</style>
