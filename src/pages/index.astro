---
import Layout from "../layouts/Layout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import { SITE } from "../lib/site";

const bookJsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: SITE.book.title,
  alternateName: SITE.book.subtitle,
  author: {
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.book.publisher,
  },
  description: SITE.description,
};
---

<Layout jsonLd={bookJsonLd}>
  <!-- Hero -->
  <section class="hero section section--lg">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">A new book by {SITE.name}</p>
          <h1>{SITE.book.title}</h1>
          <p class="hero-subtitle">{SITE.book.subtitle}</p>
          <div class="hero-actions">
            <a href="/the-idea-drug" class="btn btn--primary">Get the book</a>
            <a href="#free-chapter" class="btn btn--ghost">Free first chapter</a>
          </div>
        </div>
        <div class="hero-image">
          <!-- Book cover image -->
          <img
            src="/images/cover.png"
            alt="The Idea Drug book cover"
            width="400"
            height="600"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <hr class="divider-accent" />

  <!-- Core thesis -->
  <section class="section">
    <div class="container container--narrow">
      <p class="pull-quote">
        "Ideas are killing innovation. They're the default output of our fast,
        impulsive brain — solutions in disguise that hijack attention away from
        customer need."
      </p>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="section section--sm">
    <div class="container">
      <div class="grid grid--3">
        <div class="stat-block">
          <p class="stat-number">75%</p>
          <p class="stat-label">of startups fail</p>
        </div>
        <div class="stat-block">
          <p class="stat-number">$2-3T</p>
          <p class="stat-label">spent building products nobody wants — per year</p>
        </div>
        <div class="stat-block">
          <p class="stat-number">75x</p>
          <p class="stat-label">more effective with a hypothesis-led approach</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Mark (brief) -->
  <section class="section">
    <div class="container container--narrow">
      <h2>Hello, I'm Mark</h2>
      <p>
        I'm an entrepreneur, investor and systems thinker who has spent the last
        two decades dismantling one of business's most cherished myths: that
        innovation is driven by ideas. As founder of System Two, I've built and
        backed companies across energy, healthcare, finance and technology —
        exiting multiple ventures including Deep Green (acquired by Octopus).
      </p>
      <a href="/about" class="btn btn--ghost">More about me</a>
    </div>
  </section>

  <!-- Email capture -->
  <section class="section" id="free-chapter">
    <div class="container container--narrow">
      <EmailCapture />
    </div>
  </section>
</Layout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sys-color-primary, #d42020);
    margin-bottom: 1rem;
  }

  .hero-copy h1 {
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    max-height: 500px;
    width: auto;
    box-shadow: var(--sys-surface-shadows-image, 0 16px 32px rgba(0, 0, 0, 0.12));
  }

  .stat-block {
    text-align: center;
    padding: 1.5rem;
  }

  .stat-number {
    font-family: var(--sys-font-family-display, 'Jost', sans-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--sys-color-primary, #d42020);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--sys-color-on-surface-muted, #6b7280);
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
    }

    .hero-image img {
      max-height: 350px;
    }
  }
</style>
